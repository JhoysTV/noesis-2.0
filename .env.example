APP_ENV=production
APP_BASE_URL=https://tu-dominio.com
ALLOWED_ORIGINS=https://tu-dominio.com
DATABASE_PATH=backend/data/noesis.sqlite3

# Stripe
STRIPE_SECRET_KEY=sk_live_reemplazar
STRIPE_WEBHOOK_SECRET=whsec_reemplazar
STRIPE_CURRENCY=dop

# Admin — panel en /admin
# ADMIN_USERNAME: nombre de usuario para el login del panel
# ADMIN_PASSWORD: contraseña de acceso (usa una cadena larga y aleatoria)
# ADMIN_TOKEN:    token bearer para las llamadas API (puede ser diferente a la contraseña)
#                 Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena-larga
ADMIN_TOKEN=cambia-este-token-largo

# Correos transaccionales SMTP
STUDIO_EMAIL=info@noesisdelcaribe.com
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USERNAME=usuario
SMTP_PASSWORD=password
SMTP_FROM_EMAIL=info@noesisdelcaribe.com
SMTP_USE_TLS=true
